<%
    const selectedPage = typeof activePage === "string" ? activePage : "";
    const navItems = [
        {label: "Dashboard", page: "dashboard", href: "/dashboard"},
        {label: "Comptes", page: "comptes", href: "/dashboard/comptes"},
        {label: "B&eacute;n&eacute;ficiaires", page: "beneficiaires", href: "/dashboard/beneficiaires"},
        {label: "Virements", page: "virements", href: "/dashboard/virements"},
        {label: "Historique", page: "historique", href: "/dashboard/historique"},
        {label: "Cartes", page: "cartes", href: "/dashboard/cartes"},
        {label: "R&eacute;clamations", page: "reclamations", href: "/dashboard/reclamations"}
    ];
%>

<nav class="border-b border-slate-200 bg-white" aria-label="Navigation principale">
    <div class="flex min-h-[50px] items-center gap-8 px-4 sm:px-6">
        <a href="/dashboard" class="flex shrink-0 items-center gap-2" aria-label="HosBank - Dashboard">
            <span class="flex size-6 items-center justify-center rounded-lg bg-[#3478f6] text-sm font-bold text-white">
                H
            </span>
            <span class="text-xs font-semibold text-[#17478f]">HosBank</span>
        </a>

        <div class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            <% navItems.forEach((item) => { %>
                <a
                    href="<%= item.href %>"
                    class="whitespace-nowrap rounded-xl px-3 py-2 text-xs font-medium transition-colors <%= selectedPage === item.page
                        ? 'bg-[#eff4ff] text-[#0057d9]'
                        : 'text-slate-700 hover:bg-slate-50 hover:text-[#0057d9]' %>"
                    <%- selectedPage === item.page ? 'aria-current="page"' : '' %>
                >
                    <%- item.label %>
                </a>
            <% }); %>
        </div>
    </div>
</nav>
