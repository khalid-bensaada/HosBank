<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tableau de bord client HosBank">
    <title>Tableau de bord | HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>
<body class="dashboard-page">
    <%- include("../components/navbar", {activePage: "dashboard"}) %>

    <main class="dashboard-shell">
        <section class="welcome-card" aria-labelledby="welcome-title">
            <div class="welcome-copy">
                <h1 id="welcome-title">Bonjour, <span><%= user.prenom %></span></h1>
                <p>Bienvenue dans votre espace bancaire personnel.</p>
            </div>
        </section>

        <section class="balance-grid" aria-label="Vue d'ensemble des comptes">
            <article class="balance-card">
                <div class="balance-heading">
                    <p class="balance-label">Compte courant</p>
                    <span class="balance-icon balance-icon-blue" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 9h16M6 9V7l6-3 6 3v2M6 18h12M8 9v7m4-7v7m4-7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </div>
                <p class="balance-value">0 <span>MAD</span></p>
            </article>

            <article class="balance-card">
                <div class="balance-heading">
                    <p class="balance-label">Livret Hos+</p>
                    <span class="balance-icon balance-icon-violet" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" stroke="currentColor" stroke-width="1.7"/><path d="M12 7v10m3-7.5c0-1.1-1.34-2-3-2s-3 .9-3 2 1.34 2 3 2 3 .9 3 2-1.34 2-3 2-3-.9-3-2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </span>
                </div>
                <p class="balance-value">0 <span>MAD</span></p>
            </article>

            <article class="balance-card">
                <div class="balance-heading">
                    <p class="balance-label">Patrimoine net total</p>
                    <span class="balance-icon balance-icon-green" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="m4 16 5-5 4 3 7-8M15 6h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </div>
                <p class="balance-value">0 <span>MAD</span></p>
            </article>
        </section>

        <section class="content-grid">
            <article class="transactions-card">
                <header class="card-header">
                    <div>
                        <h2>Transactions r&eacute;centes</h2>
                        <p>Aper&ccedil;u de vos derni&egrave;res op&eacute;rations</p>
                    </div>
                </header>

                <div class="table-wrap">
                    <table class="transactions-table">
                        <thead>
                            <tr>
                                <th scope="col">Date &amp; heure</th>
                                <th scope="col">Op&eacute;ration &amp; marchand</th>
                                <th scope="col">Cat&eacute;gorie</th>
                                <th scope="col">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-label="Date"><span class="date-main">Aujourd&rsquo;hui</span><span class="date-time">11:24</span></td>
                                <td data-label="Op&eacute;ration"><span class="merchant">Biocoop March&eacute; Bio</span></td>
                                <td data-label="Cat&eacute;gorie"><span class="category category-food">Alimentation</span></td>
                                <td data-label="Montant"><span class="amount amount-debit">&minus;42,80 MAD</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </article>

            <aside class="profile-card" aria-labelledby="profile-title">
                <header class="profile-header">
                    <div class="profile-title-wrap">
                        <span class="section-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                        </span>
                        <h2 id="profile-title">Informations du profil</h2>
                    </div>
                </header>

                <div class="profile-identity">
                    <span class="profile-avatar" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                    </span>
                    <div>
                        <strong><%= user.prenom %> <%= user.nom %></strong>
                        <span>Client HosBank</span>
                    </div>
                </div>

                <dl class="profile-details">
                    <div>
                        <dt>Adresse e-mail</dt>
                        <dd><%= user.email %></dd>
                    </div>
                    <div>
                        <dt>T&eacute;l&eacute;phone</dt>
                        <dd><%= user.telephone || "Non renseigné" %></dd>
                    </div>
                    <div>
                        <dt>Adresse</dt>
                        <dd><%= user.adresse || "Non renseignée" %></dd>
                    </div>
                </dl>
            </aside>
        </section>
    </main>
</body>
</html>
