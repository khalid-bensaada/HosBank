<%
    const accountList = typeof comptes !== "undefined" && Array.isArray(comptes) ? comptes : [];
    const currency = new Intl.NumberFormat("fr-MA", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
    const totalBalance = accountList.reduce((total, account) => total + Number(account.solde || 0), 0);
    const hasSavingsAccount = accountList.some((account) =>
        String(account.typedecompte || "").toUpperCase() === "EPARGNE"
    );
    const savingsAccount = accountList.find((account) =>
        String(account.typedecompte || "").toUpperCase() === "EPARGNE"
    );
    const accountTypeLabel = (type) => {
        const normalized = String(type || "").toUpperCase();
        return normalized === "EPARGNE" ? "Compte epargne" : "Compte courant";
    };
    const maskedIban = (iban) => {
        const value = String(iban || "");
        return value.length > 8 ? `${value.slice(0, 4)} **** **** ${value.slice(-4)}` : value;
    };
    const accountStatusLabel = (status) => {
        const normalized = String(status || "").toLowerCase();
        return normalized === "inactive" ? "En attente de validation" : "Actif";
    };
%>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Vos comptes HosBank">
    <title>Mes comptes | HosBank</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>
<body class="dashboard-page accounts-page">
    <%- include("../components/navbar", {activePage: "comptes"}) %>

    <main class="dashboard-shell accounts-shell">
        <section class="accounts-intro" aria-labelledby="accounts-title">
            <div>
                <p class="page-eyebrow">Espace bancaire</p>
                <h1 id="accounts-title">Mes comptes</h1>
                <p>Retrouvez vos soldes et ouvrez un compte epargne en quelques instants.</p>
            </div>
            <a class="open-savings-link" href="#ouvrir-epargne">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <span>Ouvrir un compte epargne</span>
            </a>
        </section>

        <% if (success) { %>
            <p class="account-alert account-alert-success" role="status"><%= success %></p>
        <% } %>
        <% if (error) { %>
            <p class="account-alert account-alert-error" role="alert"><%= error %></p>
        <% } %>

        <section class="total-balance" aria-label="Solde total de vos comptes">
            <div>
                <p>Solde total disponible</p>
                <strong><%= currency.format(totalBalance) %> <span>MAD</span></strong>
                <small><%= accountList.length %> compte<%= accountList.length > 1 ? "s" : "" %> ouvert<%= accountList.length > 1 ? "s" : "" %></small>
            </div>
            <span class="total-balance-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 9h16M6 9V7l6-3 6 3v2M6 18h12M8 9v7m4-7v7m4-7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
        </section>

        <section class="accounts-section" aria-labelledby="your-accounts-title">
            <header class="section-heading">
                <div>
                    <h2 id="your-accounts-title">Vos comptes</h2>
                    <p>Consultez vos informations essentielles.</p>
                </div>
            </header>

            <% if (accountList.length) { %>
                <div class="account-list">
                    <% accountList.forEach((account) => { %>
                        <article class="account-item <%= String(account.typedecompte || "").toUpperCase() === "EPARGNE" ? "account-item-savings" : "" %>">
                            <div class="account-item-top">
                                <span class="account-item-icon" aria-hidden="true">
                                    <% if (String(account.typedecompte || "").toUpperCase() === "EPARGNE") { %>
                                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" stroke="currentColor" stroke-width="1.7"/><path d="M12 7v10m3-7.5c0-1.1-1.34-2-3-2s-3 .9-3 2 1.34 2 3 2 3 .9 3 2-1.34 2-3 2-3-.9-3-2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                                    <% } else { %>
                                        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.7"/></svg>
                                    <% } %>
                                </span>
                                <span class="account-state <%= String(account.status || "").toLowerCase() === "inactive" ? "is-pending" : "" %>"><%= accountStatusLabel(account.status) %></span>
                            </div>
                            <div class="account-item-name">
                                <p><%= accountTypeLabel(account.typedecompte) %></p>
                                <span><%= account.numeroCompte || "Numero en cours d'attribution" %></span>
                            </div>
                            <p class="account-item-balance"><%= currency.format(Number(account.solde || 0)) %> <span>MAD</span></p>
                            <dl class="account-meta">
                                <div>
                                    <dt>IBAN</dt>
                                    <dd><%= maskedIban(account.iban) %></dd>
                                </div>
                                <div>
                                    <dt>Ouverture</dt>
                                    <dd><%= account.dateOuverture ? new Date(account.dateOuverture).toLocaleDateString("fr-MA") : "-" %></dd>
                                </div>
                            </dl>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="accounts-empty">
                    <span class="accounts-empty-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 9h16M6 9V7l6-3 6 3v2M6 18h12M8 9v7m4-7v7m4-7v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div>
                        <h3>Aucun compte disponible</h3>
                        <p>Commencez par ouvrir votre compte epargne ci-dessous.</p>
                    </div>
                </div>
            <% } %>
        </section>

        <section class="savings-opening" id="ouvrir-epargne" aria-labelledby="savings-title">
            <div class="savings-copy">
                <span class="savings-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" stroke="currentColor" stroke-width="1.7"/><path d="M12 7v10m3-7.5c0-1.1-1.34-2-3-2s-3 .9-3 2 1.34 2 3 2 3 .9 3 2-1.34 2-3 2-3-.9-3-2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </span>
                <p class="page-eyebrow">Nouveau compte</p>
                <h2 id="savings-title">Compte epargne Hos+</h2>
                <p>Choisissez le montant a transferer depuis votre compte courant. Votre demande sera ensuite verifiee par un charge client.</p>
                <ul class="savings-features">
                    <li>Sans frais d'ouverture</li>
                    <li>Montant transfere depuis le compte courant</li>
                    <li>Activation apres verification</li>
                </ul>
            </div>

            <div class="savings-form-wrap">
                <% if (hasSavingsAccount) { %>
                    <div class="savings-already-open" role="status">
                        <span aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                        <div>
                            <strong><%= String(savingsAccount.status || "").toLowerCase() === "inactive" ? "Votre demande est en cours de verification" : "Votre compte epargne est actif" %></strong>
                            <p>Son solde apparait dans la liste de vos comptes.</p>
                        </div>
                    </div>
                <% } else { %>
                    <form action="/dashboard/comptes/epargne" method="post" class="savings-form">
                        <h3>Ouvrir mon compte</h3>
                        <p>Le montant sera debite de votre compte courant et credite sur votre compte epargne en attente de validation.</p>
                        <label class="amount-field" for="initialAmount">
                            <span>Montant a transferer</span>
                            <span class="amount-input-wrap">
                                <input id="initialAmount" name="initialAmount" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" required>
                                <b>MAD</b>
                            </span>
                        </label>
                        <label class="terms-check">
                            <input type="checkbox" name="acceptTerms" required>
                            <span>J'accepte les conditions de fonctionnement du compte epargne.</span>
                        </label>
                        <button class="savings-submit" type="submit">
                            <span>Creer mon compte epargne</span>
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </form>
                <% } %>
            </div>
        </section>
    </main>
</body>
</html>
