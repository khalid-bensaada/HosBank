<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un compte</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center p-4 bg-slate-100">

<div class="w-full max-w-3xl bg-white rounded-2xl shadow-lg p-8">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 mb-2">Créer un compte</h1>
        <p class="text-slate-500 text-sm">
            Rejoignez une banque pensée pour vous. Simple, transparente et sans engagement.
        </p>
    </div>

    <% if (typeof error !== "undefined" && error) { %>
        <p class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"><%= error %></p>
    <% } %>

    <% if (typeof success !== "undefined" && success) { %>
        <p class="mb-5 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700" role="status"><%= success %></p>
    <% } %>

    <form action="/auth/register" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <div>
            <label for="nom" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Nom
            </label>
            <input type="text" id="nom" name="nom" placeholder="Aisam"
                   class="w-full px-4 py-3 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   required>
        </div>

        <div>
            <label for="prenom" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Prénom
            </label>
            <input type="text" id="prenom" name="prenom" placeholder="SirajEddin"
                   class="w-full px-4 py-3 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   required>
        </div>

        <div>
            <label for="email" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Adresse e-mail
            </label>
            <input type="email" id="email" name="email" placeholder="ma3lina@gmail.com"
                   class="w-full px-4 py-3 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   required>
        </div>

        <div>
            <label for="motdepass" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Mot de passe
            </label>
            <input type="password" id="motdepass" name="motdepass" placeholder="*******"
                   class="w-full px-4 py-3 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   required>
        </div>

        <div>
            <label for="telephone" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Téléphone
            </label>
            <input type="tel" id="telephone" name="telephone" placeholder="06 12 34 56 78"
                   class="w-full px-4 py-3 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   required>
        </div>

        <div>
            <label for="adresse" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Adresse
            </label>
            <textarea id="adresse" name="adresse" rows="1" placeholder="Votre adresse"
                      class="w-full px-4 py-3 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                       required></textarea>
        </div>

        <div>
            <label for="soldeInitial" class="block text-xs font-bold text-slate-500 uppercase mb-2">
                Solde initial du compte courant
            </label>
            <div class="relative">
                <input type="number" id="soldeInitial" name="soldeInitial" min="0" step="0.01" inputmode="decimal" placeholder="0.00"
                       class="w-full px-4 py-3 pr-16 bg-slate-100 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                       required>
                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-xs font-bold text-slate-500">MAD</span>
            </div>
        </div>

        <button type="submit"
                class="md:col-span-2 w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-sm transition">
            Créer mon compte
        </button>
    </form>

    <div class="mt-6 text-center">
        <p class="text-xs text-slate-500">
            Déjà un compte ?
            <a href="/auth/login" class="text-blue-600 font-bold hover:underline">
                Se connecter
            </a>
        </p>
    </div>

</div>

</body>

</html>
