<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HosBank - Comptes Bancaires</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#F8F9FE] text-gray-800 font-sans antialiased">

<header class="bg-white border-b border-gray-100 px-8 py-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-8">
            <div class="text-xl font-extrabold text-[#2563EB] flex items-center gap-2">
                <span class="bg-[#2563EB] text-white rounded-lg w-7 h-7 flex items-center justify-center text-sm">H</span>
                HosBank
            </div>
            <nav class="flex items-center space-x-2 text-sm font-medium text-gray-600">
                <a href="/admin/dashboard" class="px-4 py-2 hover:text-gray-900">Dashboard</a>
                <a href="/admin/utilisateurs" class="px-4 py-2 hover:text-gray-900">Utilisateurs</a>
                <a href="/admin/comptes" class="bg-[#2563EB] text-white px-4 py-2 rounded-lg font-semibold">Comptes</a>
                <a href="/admin/cartes" class="px-4 py-2 hover:text-gray-900">Cartes</a>
                <a href="/admin/virements" class="px-4 py-2 hover:text-gray-900">Virements</a>
                <a href="/admin/reclamations" class="px-4 py-2 hover:text-gray-900">Réclamations</a>
            </nav>
        </div>
    </div>
</header>

<main class="max-w-6xl mx-auto px-6 py-8">

    <p class="text-xs text-gray-400 mb-2">
        <a href="/admin/dashboard" class="hover:text-[#2563EB]">Administration</a> &gt; <span class="text-[#2563EB] font-medium">Comptes Bancaires</span>
    </p>

    <h1 class="text-3xl font-bold text-[#0F172A]">Comptes Bancaires</h1>
    <p class="text-sm text-gray-400 mt-1 mb-6">Consultez, filtrez et supervisez l'ensemble des comptes courants et livrets de la banque.</p>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white p-5 rounded-2xl border border-gray-50 shadow-sm">
            <p class="text-xs text-gray-400 font-medium mb-1">TOTAL COMPTES ACTIFS</p>
            <p id="statActifs" class="text-2xl font-bold text-[#0F172A]">...</p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-gray-50 shadow-sm">
            <p class="text-xs text-gray-400 font-medium mb-1">COMPTES COURANTS</p>
            <p id="statCourants" class="text-2xl font-bold text-[#0F172A]">...</p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-gray-50 shadow-sm">
            <p class="text-xs text-gray-400 font-medium mb-1">LIVRETS HOS+</p>
            <p id="statHosPlus" class="text-2xl font-bold text-[#0F172A]">...</p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-gray-50 shadow-sm">
            <p class="text-xs text-gray-400 font-medium mb-1">COMPTES BLOQUÉS</p>
            <p id="statBloques" class="text-2xl font-bold text-red-500">...</p>
        </div>
    </div>

    <!-- Table Container -->
    <div class="bg-white rounded-2xl border border-gray-50 shadow-sm overflow-hidden">

        <table class="w-full text-sm">
            <thead>
            <tr class="text-xs text-gray-400 border-b border-gray-50">
                <th class="text-left font-medium px-6 py-3">NUMÉRO DE COMPTE</th>
                <th class="text-left font-medium px-6 py-3">IBAN</th>
                <th class="text-left font-medium px-6 py-3">TITULAIRE</th>
                <th class="text-left font-medium px-6 py-3">TYPE</th>
                <th class="text-right font-medium px-6 py-3">SOLDE</th>
                <th class="text-left font-medium px-6 py-3">STATUT</th>
                <th class="text-right font-medium px-6 py-3">ACTIONS</th>
            </tr>
            </thead>
            <tbody id="comptesBody">
            <tr><td colspan="7" class="text-center py-10 text-gray-400">Chargement...</td></tr>
            </tbody>
        </table>

        <div class="px-6 py-4 border-t border-gray-50">
            <button id="btnShowAll" class="text-xs text-gray-500 font-medium hover:text-[#2563EB]">
                voir tout →
            </button>
        </div>

    </div>

</main>

<script>
    const API_BASE = '/admin/api';
    let allComptes = [];
    let displayLimit = 7;

    async function fetchWithAuth(url, options = {}) {
        const res = await fetch(url, {
            ...options,
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', ...(options.headers || {}) }
        });
        if (res.status === 401 || res.status === 403) {
            window.location.href = '/auth/login';
            throw new Error('Unauthorized');
        }
        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.message || 'Request failed');
        }
        return res.json();
    }

    function formatMontant(montant) {
        return parseFloat(montant).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function typeBadge(type) {
        if (type === 'Hos+') {
            return `<span class="bg-[#F0FDF4] text-[#16A34A] text-xs font-medium px-3 py-1 rounded-full">Hos+</span>`;
        }
        return `<span class="bg-[#EEF2FF] text-[#2563EB] text-xs font-medium px-3 py-1 rounded-full">Courant</span>`;
    }

    function statusBadge(status) {
        if (status === 'actif') {
            return `<span class="bg-[#F0FDF4] text-[#16A34A] text-xs font-medium px-3 py-1 rounded-full">● Actif</span>`;
        }
        return `<span class="bg-[#FEF2F2] text-[#EF4444] text-xs font-medium px-3 py-1 rounded-full">● Bloqué</span>`;
    }

    function renderCompteRow(c) {
        const isBlocked = c.status !== 'actif';
        return `
            <tr class="border-b border-gray-50 last:border-b-0">
                <td class="px-6 py-4 font-mono font-semibold ${isBlocked ? 'text-red-500' : 'text-gray-900'}">${c.numeroCompte}</td>
                <td class="px-6 py-4 font-mono text-gray-400">${c.iban}</td>
                <td class="px-6 py-4 text-gray-700">${c.nom} ${c.prenom}</td>
                <td class="px-6 py-4">${typeBadge(c.typedecompte)}</td>
                <td class="px-6 py-4 text-right font-semibold text-gray-900">${formatMontant(c.solde)} MAD</td>
                <td class="px-6 py-4">${statusBadge(c.status)}</td>
                <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-2">
                        <button onclick="handleView(${c.id})" class="bg-[#EEF2FF] text-[#2563EB] hover:bg-blue-100 text-xs font-medium px-3 py-1.5 rounded-md">
                            Voir
                        </button>
                        <button onclick="handleToggleStatus(${c.id})" class="${c.status === 'actif' ? 'bg-[#FEF2F2] text-[#EF4444] hover:bg-red-100' : 'bg-[#F0FDF4] text-[#16A34A] hover:bg-green-100'} text-xs font-medium px-3 py-1.5 rounded-md">
                            ${c.status === 'actif' ? 'Bloquer' : 'Débloquer'}
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }

    function renderComptes() {
        const tbody = document.getElementById('comptesBody');
        const toShow = allComptes.slice(0, displayLimit);

        if (toShow.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-10 text-gray-400">Aucun compte trouvé.</td></tr>`;
            return;
        }

        tbody.innerHTML = toShow.map(renderCompteRow).join('');

        document.getElementById('btnShowAll').style.display = displayLimit >= allComptes.length ? 'none' : 'block';
    }

    async function loadStats() {
        try {
            const res = await fetchWithAuth(`${API_BASE}/comptes/stats`);
            const data = res.data;
            document.getElementById('statActifs').textContent = data.totalActifs;
            document.getElementById('statCourants').textContent = data.courants;
            document.getElementById('statHosPlus').textContent = data.hosPlus;
            document.getElementById('statBloques').textContent = data.bloques;
        } catch (error) {
            console.error(error);
        }
    }

    async function loadComptes() {
        try {
            const res = await fetchWithAuth(`${API_BASE}/comptes`);
            allComptes = res.data || [];
            renderComptes();
        } catch (error) {
            document.getElementById('comptesBody').innerHTML =
                `<tr><td colspan="7" class="text-center py-10 text-red-400">Erreur lors du chargement.</td></tr>`;
            console.error(error);
        }
    }

    function handleView(id) {
        window.location.href = `/admin/comptes/${id}`;
    }

    async function handleToggleStatus(id) {
        if (!confirm('Voulez-vous changer le statut de ce compte ?')) return;
        try {
            await fetchWithAuth(`${API_BASE}/comptes/${id}/toggle-status`, { method: 'PUT' });
            await loadComptes();
            await loadStats();
        } catch (error) {
            alert('Erreur lors de la mise à jour du statut.');
            console.error(error);
        }
    }

    document.getElementById('btnShowAll').addEventListener('click', () => {
        displayLimit = allComptes.length;
        renderComptes();
    });

    // Init
    loadStats();
    loadComptes();
</script>

</body>
</html>