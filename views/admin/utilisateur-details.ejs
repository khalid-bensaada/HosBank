
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HosBank - Détails Utilisateur</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#F8F9FE] text-gray-800 font-sans antialiased">


<header class="bg-white border-b border-gray-100 px-8 py-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-8">
            <div class="text-xl font-extrabold text-[#2563EB] flex items-center gap-2">
                <span class="bg-[#2563EB] text-white rounded-lg w-7 h-7 flex items-center justify-center text-sm">H</span>
                HosBank
            </div>
            <nav class="flex items-center space-x-2 text-sm font-medium text-gray-600">
                <a href="/admin/dashboard" class="px-4 py-2 hover:text-gray-900">Dashboard</a>
                <a href="/admin/utilisateurs" class="bg-[#2563EB] text-white px-4 py-2 rounded-lg font-semibold">Utilisateurs</a>
                <a href="/admin/comptes" class="px-4 py-2 hover:text-gray-900">Comptes</a>
                <a href="/admin/cartes" class="px-4 py-2 hover:text-gray-900">Cartes</a>
                <a href="/admin/virements" class="px-4 py-2 hover:text-gray-900">Virements</a>
                <a href="/admin/reclamations" class="px-4 py-2 hover:text-gray-900">Réclamations</a>
            </nav>
        </div>
    </div>
</header>


<main class="max-w-6xl mx-auto px-6 py-8">


    <p class="text-xs text-gray-400 mb-2">
        <a href="/admin/utilisateurs" class="hover:text-[#2563EB]">Administration / Utilisateurs</a> / <span class="text-[#2563EB] font-medium">Détails</span>
    </p>

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 id="pageTitle" class="text-3xl font-bold text-[#0F172A]">Chargement...</h1>
            <p class="text-sm text-gray-400 mt-1">Informations complètes du compte utilisateur.</p>
        </div>
        <a href="/admin/utilisateurs" class="text-sm text-gray-500 hover:text-[#2563EB] font-medium">← Retour à la liste</a>
    </div>

    <div id="loadingState" class="text-center py-20 text-gray-400 text-sm">
        Chargement des informations...
    </div>

    <div id="content" class="hidden space-y-6">

        <!-- User Info Card -->
        <div class="bg-white rounded-2xl border border-gray-50 shadow-sm p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Informations personnelles</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                <div>
                    <p class="text-xs text-gray-400 mb-1">Nom complet</p>
                    <p id="userFullName" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Email</p>
                    <p id="userEmail" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Téléphone</p>
                    <p id="userPhone" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Adresse</p>
                    <p id="userAddress" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Email vérifié</p>
                    <p id="userEmailVerified" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Rôle</p>
                    <p id="userRole" class="text-sm font-semibold text-gray-900">—</p>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-6 pt-6 border-t border-gray-50">
                <span class="text-xs text-gray-400">Statut :</span>
                <span id="userStatutBadge"></span>
                <button id="btnToggleStatus" class="text-xs font-medium px-3 py-1.5 rounded-md ml-auto"></button>
                <button id="btnChangeRole" class="bg-[#F0F4FF] text-[#4F46E5] hover:bg-indigo-100 text-xs font-medium px-3 py-1.5 rounded-md">
                    Changer rôle
                </button>
            </div>
        </div>


        <div class="bg-white rounded-2xl border border-gray-50 shadow-sm overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-50">
                <h2 class="text-lg font-bold text-gray-900">Comptes bancaires</h2>
                <p class="text-xs text-gray-400 mt-1">Tous les comptes associés à cet utilisateur</p>
            </div>

            <table class="w-full text-sm">
                <thead>
                <tr class="text-xs text-gray-400 border-b border-gray-50">
                    <th class="text-left font-medium px-6 py-3">Numéro de Compte</th>
                    <th class="text-left font-medium px-6 py-3">IBAN</th>
                    <th class="text-left font-medium px-6 py-3">Type</th>
                    <th class="text-right font-medium px-6 py-3">Solde</th>
                    <th class="text-left font-medium px-6 py-3">Statut</th>
                </tr>
                </thead>
                <tbody id="comptesBody">
                <tr><td colspan="5" class="text-center py-8 text-gray-400">Chargement...</td></tr>
                </tbody>
            </table>
        </div>

    </div>

    <div id="errorState" class="hidden text-center py-20 text-red-400 text-sm">
        Utilisateur non trouvé ou erreur de chargement.
    </div>

</main>

<script>
    const API_BASE = '/admin/api';
    const userId = <%= userId %>;
    let currentUser = null;

    async function fetchWithAuth(url, options = {}) {
        const res = await fetch(url, {
            ...options,
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json',
                ...(options.headers || {})
            }
        });

        if (res.status === 401 || res.status === 403) {
            window.location.href = '/auth/login';
            throw new Error('Unauthorized');
        }

        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            throw new Error(err.message || 'Request failed');
        }

        return res.json();
    }

    function formatMontant(montant) {
        return parseFloat(montant).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function statutBadgeHtml(statut) {
        if (statut === 'actif') {
            return `<span class="bg-[#F0FDF4] text-[#16A34A] text-xs font-medium px-3 py-1 rounded-full">Actif</span>`;
        }
        return `<span class="bg-[#F3F4F6] text-gray-500 text-xs font-medium px-3 py-1 rounded-full">Inactif</span>`;
    }

    function renderCompteRow(c) {
        return `
            <tr class="border-b border-gray-50 last:border-b-0">
                <td class="px-6 py-4 font-mono text-gray-900">${c.numeroCompte}</td>
                <td class="px-6 py-4 font-mono text-gray-500">${c.iban}</td>
                <td class="px-6 py-4 text-gray-600">${c.typedecompte}</td>
                <td class="px-6 py-4 text-right font-semibold text-gray-900">${formatMontant(c.solde)} MAD</td>
                <td class="px-6 py-4">${statutBadgeHtml(c.status)}</td>
            </tr>
        `;
    }

    function renderUser(user) {
        document.getElementById('pageTitle').textContent = `${user.nom} ${user.prenom}`;
        document.getElementById('userFullName').textContent = `${user.nom} ${user.prenom}`;
        document.getElementById('userEmail').textContent = user.email;
        document.getElementById('userPhone').textContent = user.telephone || '—';
        document.getElementById('userAddress').textContent = user.adresse || '—';
        document.getElementById('userEmailVerified').textContent = user.emailVerifie ? 'Oui' : 'Non';
        document.getElementById('userRole').textContent = user.roleName === 'admin' ? 'Administrateur' : 'Client';

        document.getElementById('userStatutBadge').innerHTML = statutBadgeHtml(user.statut);

        const btnToggle = document.getElementById('btnToggleStatus');
        const isActive = user.statut === 'actif';
        btnToggle.textContent = isActive ? 'Désactiver' : 'Activer';
        btnToggle.className = isActive
            ? 'bg-[#FEF2F2] text-[#EF4444] hover:bg-red-100 text-xs font-medium px-3 py-1.5 rounded-md ml-auto'
            : 'bg-[#F0FDF4] text-[#16A34A] hover:bg-green-100 text-xs font-medium px-3 py-1.5 rounded-md ml-auto';

        const comptesBody = document.getElementById('comptesBody');
        if (!user.comptes || user.comptes.length === 0) {
            comptesBody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-gray-400">Aucun compte bancaire.</td></tr>`;
        } else {
            comptesBody.innerHTML = user.comptes.map(renderCompteRow).join('');
        }
    }

    async function loadUserDetails() {
        try {
            const res = await fetchWithAuth(`${API_BASE}/utilisateurs/${userId}`);
            currentUser = res.data;

            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('content').classList.remove('hidden');

            renderUser(currentUser);

        } catch (error) {
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('errorState').classList.remove('hidden');
            console.error(error);
        }
    }

    document.getElementById('btnToggleStatus').addEventListener('click', async () => {
        if (!confirm('Voulez-vous changer le statut de cet utilisateur ?')) return;

        try {
            await fetchWithAuth(`${API_BASE}/utilisateurs/${userId}/toggle-status`, { method: 'PUT' });
            await loadUserDetails();
        } catch (error) {
            alert('Erreur lors de la mise à jour du statut.');
            console.error(error);
        }
    });

    document.getElementById('btnChangeRole').addEventListener('click', async () => {
        const newRoleId = currentUser.roleId === 2 ? 1 : 2;
        const roleLabel = newRoleId === 2 ? 'Administrateur' : 'Client';

        if (!confirm(`Voulez-vous changer le rôle de cet utilisateur en "${roleLabel}" ?`)) return;

        try {
            await fetchWithAuth(`${API_BASE}/utilisateurs/${userId}/role`, {
                method: 'PUT',
                body: JSON.stringify({ roleId: newRoleId })
            });
            await loadUserDetails();
        } catch (error) {
            alert('Erreur lors du changement de rôle.');
            console.error(error);
        }
    });


    loadUserDetails();
</script>

</body>
</html>