<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HosBank - Détails Virement</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#F8F9FE] text-gray-800 font-sans antialiased">

<header class="bg-white border-b border-gray-100 px-8 py-4">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-8">
            <div class="text-xl font-extrabold text-[#2563EB] flex items-center gap-2">
                <span class="bg-[#2563EB] text-white rounded-lg w-7 h-7 flex items-center justify-center text-sm">H</span>
                HosBank
            </div>
            <nav class="flex items-center space-x-2 text-sm font-medium text-gray-600">
                <a href="/admin/dashboard" class="px-4 py-2 hover:text-gray-900">Dashboard</a>
                <a href="/admin/utilisateurs" class="px-4 py-2 hover:text-gray-900">Utilisateurs</a>
                <a href="/admin/comptes" class="px-4 py-2 hover:text-gray-900">Comptes</a>
                <a href="/admin/cartes" class="px-4 py-2 hover:text-gray-900">Cartes</a>
                <a href="/admin/virements" class="bg-[#2563EB] text-white px-4 py-2 rounded-lg font-semibold">Virements</a>
                <a href="/admin/reclamations" class="px-4 py-2 hover:text-gray-900">Réclamations</a>
            </nav>
        </div>
    </div>
</header>

<main class="max-w-6xl mx-auto px-6 py-8">

    <p class="text-xs text-gray-400 mb-2">
        <a href="/admin/virements" class="hover:text-[#2563EB]">Administration / Virements</a> / <span class="text-[#2563EB] font-medium">Détails</span>
    </p>

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 id="pageTitle" class="text-3xl font-bold text-[#0F172A]">Chargement...</h1>
            <p class="text-sm text-gray-400 mt-1">Détails complets de l'opération de virement.</p>
        </div>
        <a href="/admin/virements" class="text-sm text-gray-500 hover:text-[#2563EB] font-medium">← Retour à la liste</a>
    </div>

    <div id="loadingState" class="text-center py-20 text-gray-400 text-sm">
        Chargement des informations...
    </div>

    <div id="content" class="hidden space-y-6">

        <!-- Virement Info -->
        <div class="bg-white rounded-2xl border border-gray-50 shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-bold text-gray-900">Informations du virement</h2>
                <span id="virementStatutBadge"></span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                <div>
                    <p class="text-xs text-gray-400 mb-1">Référence</p>
                    <p id="virementReference" class="text-sm font-semibold text-gray-900 font-mono">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Montant</p>
                    <p id="virementMontant" class="text-sm font-bold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Date & Heure</p>
                    <p id="virementDate" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div class="col-span-2 md:col-span-3">
                    <p class="text-xs text-gray-400 mb-1">Motif</p>
                    <p id="virementMotif" class="text-sm font-semibold text-gray-900">—</p>
                </div>
            </div>
        </div>

        <!-- Compte Source -->
        <div class="bg-white rounded-2xl border border-gray-50 shadow-sm p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Compte source</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                <div>
                    <p class="text-xs text-gray-400 mb-1">Titulaire</p>
                    <p id="sourceTitulaire" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Email</p>
                    <p id="sourceEmail" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Numéro de compte</p>
                    <p id="sourceCompte" class="text-sm font-semibold text-gray-900 font-mono">—</p>
                </div>
            </div>
        </div>

        <!-- Bénéficiaire -->
        <div class="bg-white rounded-2xl border border-gray-50 shadow-sm p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Bénéficiaire</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                <div>
                    <p class="text-xs text-gray-400 mb-1">Nom complet</p>
                    <p id="beneficiaireNom" class="text-sm font-semibold text-gray-900">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">IBAN</p>
                    <p id="beneficiaireIban" class="text-sm font-semibold text-gray-900 font-mono">—</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-1">Banque</p>
                    <p id="beneficiaireBanque" class="text-sm font-semibold text-gray-900">—</p>
                </div>
            </div>
        </div>

    </div>

    <div id="errorState" class="hidden text-center py-20 text-red-400 text-sm">
        Virement non trouvé ou erreur de chargement.
    </div>

</main>

<script>
    const API_BASE = '/admin/api';
    const virementId = <%= virementId %>;

    async function fetchWithAuth(url) {
        const res = await fetch(url, { credentials: 'include' });
        if (res.status === 401 || res.status === 403) {
            window.location.href = '/auth/login';
            throw new Error('Unauthorized');
        }
        if (!res.ok) throw new Error('Request failed');
        return res.json();
    }

    function formatMontant(montant) {
        return parseFloat(montant).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatDate(dateStr) {
        const d = new Date(dateStr);
        return d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) +
            ', ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    }

    function statutBadgeHtml(statut) {
        if (statut === 'terminé') {
            return `<span class="bg-[#F0FDF4] text-[#16A34A] text-sm font-medium px-4 py-1.5 rounded-full">● Terminé</span>`;
        }
        if (statut === 'rejeté') {
            return `<span class="bg-[#FEF2F2] text-[#EF4444] text-sm font-medium px-4 py-1.5 rounded-full">● Rejeté</span>`;
        }
        return `<span class="bg-[#EEF2FF] text-[#2563EB] text-sm font-medium px-4 py-1.5 rounded-full">● ${statut}</span>`;
    }

    function renderVirement(v) {
        document.getElementById('pageTitle').textContent = `Virement ${v.reference}`;
        document.getElementById('virementReference').textContent = v.reference;
        document.getElementById('virementMontant').textContent = formatMontant(v.montant) + ' MAD';
        document.getElementById('virementDate').textContent = formatDate(v.dateCreation);
        document.getElementById('virementMotif').textContent = v.motif || '—';
        document.getElementById('virementStatutBadge').innerHTML = statutBadgeHtml(v.statut);

        document.getElementById('sourceTitulaire').textContent = `${v.nom} ${v.prenom}`;
        document.getElementById('sourceEmail').textContent = v.email;
        document.getElementById('sourceCompte').textContent = v.numeroCompte;

        document.getElementById('beneficiaireNom').textContent = v.beneficiaireNom || '—';
        document.getElementById('beneficiaireIban').textContent = v.beneficiaireIban || '—';
        document.getElementById('beneficiaireBanque').textContent = v.nomBanque || '—';
    }

    async function loadVirementDetails() {
        try {
            const res = await fetchWithAuth(`${API_BASE}/virements/${virementId}`);

            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('content').classList.remove('hidden');

            renderVirement(res.data);

        } catch (error) {
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('errorState').classList.remove('hidden');
            console.error(error);
        }
    }

    // Init
    loadVirementDetails();
</script>

</body>
</html>