<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenue sur HosBank</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center p-4 bg-slate-100">

<main class="w-full max-w-md bg-white rounded-2xl shadow-lg p-8 text-center">
    <h1 class="text-2xl font-bold text-slate-900 mb-2">
        Bienvenue sur HosBank
    </h1>

    <p class="text-slate-500 text-sm mb-6">
        Connectez-vous à votre compte ou créez-en un pour commencer.
    </p>

    <div class="space-y-3">
        <a href="/auth/login"
           class="block w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-sm transition">
            Se connecter
        </a>

        <a href="/auth/register"
           class="block w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl text-sm transition">
            Créer un compte
        </a>
    </div>
</main>

</body>

</html>
